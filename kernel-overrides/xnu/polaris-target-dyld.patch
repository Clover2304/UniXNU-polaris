+/* Exact original-input diagnostic only. No Apple trust or entitlement grant. */
+#ifndef POLARIS_APPLE_PROBE_H
+#define POLARIS_APPLE_PROBE_H
+static inline unsigned
+polaris_apple_blob_kind(const struct cs_blob *blob, int pid, int mode)
+{
+ static const unsigned char hashes[2][CS_CDHASH_LEN] = {
+  {0x1d,0x52,0xc6,0x97,0x47,0xdf,0xfc,0x4b,0x19,0x37,0xd2,0x41,0xbd,0xbc,0x9c,0xee,0x3b,0x22,0xdf,0x18},
+  {0xb4,0x79,0xf9,0x0e,0x05,0x54,0x53,0x14,0xcb,0x84,0x34,0x10,0xc3,0xd9,0x8e,0xf8,0x4d,0x92,0x67,0x10}
+ };
+ if(mode!=1 || pid!=1 || !blob || (blob->csb_flags&(CS_VALID|CS_ADHOC))!=(CS_VALID|CS_ADHOC))return 0;
+ for(unsigned kind=0;kind<2;kind++) {
+  unsigned difference=0;
+  for(unsigned i=0;i<CS_CDHASH_LEN;i++)difference|=blob->csb_cdhash[i]^hashes[kind][i];
+  if(!difference)return kind+1;
+ }
+ return 0;
+}
+#endif
