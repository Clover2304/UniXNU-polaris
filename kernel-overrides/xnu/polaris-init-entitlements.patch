@@ -55,6 +55,7 @@
 #include <sys/fcntl.h>
 #include <sys/reboot.h>
 #include <sys/code_signing.h>
+#include <pexpert/pexpert.h>
 
 #include <mach/mach_types.h>
 #include <mach/memory_object_types.h>
@@ -4348,10 +4349,53 @@
  * This function must be called when the storage for the code signature can
  * no longer change.
  */
+/* Source-only PID 1 diagnostic: the boot owner names one ad-hoc CodeDirectory.
+ * This supplies no entitlements, platform identity or Apple trust. All normal
+ * CodeDirectory parsing and executable-page integrity checks remain active.
+ */
+volatile uint32_t polaris_init_signature_accepted;
+
+static errno_t
+polaris_init_signature_policy(const struct cs_blob *blob)
+{
+	char expected[CS_CDHASH_LEN * 2 + 2] = {0};
+	const unsigned int required = CS_ADHOC | CS_HARD | CS_KILL;
+	if (proc_selfpid() != 1 || (blob->csb_flags & required) != required ||
+	    blob->csb_platform_binary || blob->csb_platform_path ||
+	    blob->csb_entitlements || blob->csb_entitlements_blob ||
+	    blob->csb_der_entitlements_blob ||
+	    !PE_parse_boot_arg_str("polaris-init-cdhash", expected, sizeof(expected)) ||
+	    strnlen(expected, sizeof(expected)) != CS_CDHASH_LEN * 2) {
+		return EPERM;
+	}
+	for (unsigned int i = 0; i < CS_CDHASH_LEN; i++) {
+		unsigned int value = 0;
+		for (unsigned int half = 0; half < 2; half++) {
+			unsigned char c = expected[i * 2 + half];
+			if (c >= '0' && c <= '9') {
+				value = (value << 4) | (c - '0');
+			} else if (c >= 'a' && c <= 'f') {
+				value = (value << 4) | (c - 'a' + 10);
+			} else {
+				return EPERM;
+			}
+		}
+		if (blob->csb_cdhash[i] != value) {
+			return EPERM;
+		}
+	}
+	polaris_init_signature_accepted++;
+	return 0;
+}
+
 static errno_t
 accelerate_entitlement_queries(
 	struct cs_blob *cs_blob)
 {
+	if (amfi == NULL) {
+		return polaris_init_signature_policy(cs_blob);
+	}
+
 	kern_return_t ret = KERN_NOT_SUPPORTED;
 
