+/* Bounded, RAM-only regular files. Included by mockfs_vnops.c after XNU headers.
+ * Mount lock: names, pool identity, vnode publication and pins.
+ * Data lock: file size, bytes, append and UBC size. Never acquire it with mount locked.
+ * Nodes remain allocated until unmount, including unlinked nodes with open vnodes.
+ */
+volatile uint64_t polaris_tmp_ready, polaris_tmp_creates, polaris_tmp_unlinks;
+volatile uint64_t polaris_tmp_reads, polaris_tmp_writes, polaris_tmp_reuses;
+static LCK_GRP_DECLARE(polaris_tmp_mtx_grp,"polaris-tmp");
+
+static int polaris_tmp_name(const char *name, unsigned length)
+{
+ if (!length || length>=32 || (length==1 && name[0]=='.') ||
+     (length==2 && name[0]=='.' && name[1]=='.')) return 0;
+ for (unsigned i=0;i<length;i++) {
+  char c=name[i];
+  if (!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='.'||c=='_'||c=='-')) return 0;
+ }
+ return 1;
+}
+static int polaris_tmp_reusable(mockfs_fsnode_t node)
+{
+ return !node->polaris_linked && !node->vp && !node->polaris_pins && !node->polaris_creating;
+}
+int polaris_tmp_init(mount_t mp)
+{
+ mockfs_mount_t mount=(mockfs_mount_t)mp->mnt_data;
+ mockfs_fsnode_t root=mount->mockfs_root;
+ if (!root || !root->polaris_named) return EINVAL;
+ for (unsigned i=0;i<POLARIS_TREE_MAX;i++) {
+  mockfs_fsnode_t n=root->polaris_children[i];
+  if (n && n->type==MOCKFS_DEV && !strcmp(n->polaris_name,"tmp")) mount->polaris_tmp_root=n;
+ }
+ if (!mount->polaris_tmp_root) return EINVAL;
+ for (unsigned i=0;i<POLARIS_TREE_MAX;i++)
+  if (mount->polaris_tmp_root->polaris_children[i]) {mount->polaris_tmp_root=NULL;return EINVAL;}
+ mount->polaris_next_id=4096;
+ for (unsigned i=0;i<32;i++) {
+  int error=mockfs_fsnode_create(mp,MOCKFS_FILE,&mount->polaris_pool[i]);
+  if (error) return error;
+  mockfs_fsnode_t n=mount->polaris_pool[i];
+  n->polaris_dynamic=1;n->polaris_named=1;n->polaris_writable=1;n->size=0;
+  n->parent=mount->polaris_tmp_root;
+  lck_mtx_init(&n->polaris_data_mtx,&polaris_tmp_mtx_grp,LCK_ATTR_NULL);
+ }
+ mp->mnt_flag&=~MNT_RDONLY;polaris_tmp_ready=1;
+ return 0;
+}
+void polaris_tmp_teardown(mockfs_mount_t mount)
+{
+ if (mount->polaris_tmp_root)
+  bzero(mount->polaris_tmp_root->polaris_children,sizeof(mount->polaris_tmp_root->polaris_children));
+ for (unsigned i=0;i<32;i++) if (mount->polaris_pool[i]) {
+  mockfs_fsnode_t n=mount->polaris_pool[i];
+  n->parent=NULL;
+  lck_mtx_destroy(&n->polaris_data_mtx,&polaris_tmp_mtx_grp);
+  if (n->polaris_pins || n->polaris_creating || mockfs_fsnode_destroy(n)) panic("mockfs: busy tmp pool at teardown");
+  mount->polaris_pool[i]=NULL;
+ }
+ mount->polaris_tmp_root=NULL;
+}
+static int polaris_tmp_lookup(struct vnop_lookup_args *ap)
+{
+ mockfs_fsnode_t dir=vnode_fsnode(ap->a_dvp), target=NULL;
+ mockfs_mount_t mount=(mockfs_mount_t)dir->mnt->mnt_data;
+ struct componentname *cn=ap->a_cnp;
+ *ap->a_vpp=NULL;
+ if (ap->a_dvp->v_type!=VDIR) return ENOTDIR;
+ if (cn->cn_nameiop!=LOOKUP && (cn->cn_flags&ISLASTCN) && dir!=mount->polaris_tmp_root) return EROFS;
+ lck_mtx_lock(&mount->mockfs_mnt_mtx);
+ if (cn->cn_namelen==1 && cn->cn_nameptr[0]=='.') target=dir;
+ else if (cn->cn_namelen==2 && !memcmp(cn->cn_nameptr,"..",2)) target=dir->parent?dir->parent:dir;
+ else for (unsigned i=0;i<POLARIS_TREE_MAX;i++) {
+  mockfs_fsnode_t n=dir->polaris_children[i];
+  if (n && strlen(n->polaris_name)==(size_t)cn->cn_namelen && !memcmp(n->polaris_name,cn->cn_nameptr,cn->cn_namelen)) {target=n;break;}
+ }
+ if (target) target->polaris_pins++;
+ lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ if (!target) return (dir==mount->polaris_tmp_root && cn->cn_nameiop==CREATE && (cn->cn_flags&ISLASTCN))?EJUSTRETURN:ENOENT;
+ int error=mockfs_fsnode_vnode(target,ap->a_vpp);
+ lck_mtx_lock(&mount->mockfs_mnt_mtx);target->polaris_pins--;lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ return error;
+}
+static int polaris_tmp_create(struct vnop_create_args *ap)
+{
+ mockfs_fsnode_t dir=vnode_fsnode(ap->a_dvp), node=NULL;
+ mockfs_mount_t mount=(mockfs_mount_t)dir->mnt->mnt_data;
+ struct componentname *cn=ap->a_cnp;
+ *ap->a_vpp=NULL;
+ if (dir!=mount->polaris_tmp_root) return EROFS;
+ if (ap->a_vap->va_type!=VREG) return ENOTSUP;
+ if (!polaris_tmp_name(cn->cn_nameptr,cn->cn_namelen)) return EINVAL;
+ int slot=-1;
+ lck_mtx_lock(&mount->mockfs_mnt_mtx);
+ for (unsigned i=0;i<POLARIS_TREE_MAX;i++) {
+  mockfs_fsnode_t n=dir->polaris_children[i];
+  if (!n) {if (slot<0) slot=(int)i;continue;}
+  if (strlen(n->polaris_name)==(size_t)cn->cn_namelen && !memcmp(n->polaris_name,cn->cn_nameptr,cn->cn_namelen)) {
+   lck_mtx_unlock(&mount->mockfs_mnt_mtx);return EEXIST;
+  }
+ }
+ if (slot>=0) for (unsigned i=0;i<32;i++)
+  if (polaris_tmp_reusable(mount->polaris_pool[i])) {node=mount->polaris_pool[i];break;}
+ if (!node) {lck_mtx_unlock(&mount->mockfs_mnt_mtx);return ENOSPC;}
+ if (node->polaris_id) polaris_tmp_reuses++;
+ node->polaris_id=mount->polaris_next_id++;node->size=0;
+ bzero(node->polaris_bytes,sizeof(node->polaris_bytes));bzero(node->polaris_name,sizeof(node->polaris_name));
+ memcpy(node->polaris_name,cn->cn_nameptr,cn->cn_namelen);
+ node->polaris_linked=1;node->polaris_pins++;
+ dir->polaris_children[slot]=node;
+ lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ int error=mockfs_fsnode_vnode(node,ap->a_vpp);
+ lck_mtx_lock(&mount->mockfs_mnt_mtx);
+ node->polaris_pins--;
+ if (error) {if (dir->polaris_children[slot]==node) dir->polaris_children[slot]=NULL;node->polaris_linked=0;}
+ else polaris_tmp_creates++;
+ lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ return error;
+}
+static int polaris_tmp_remove(struct vnop_remove_args *ap)
+{
+ mockfs_fsnode_t dir=vnode_fsnode(ap->a_dvp), node=vnode_fsnode(ap->a_vp);
+ mockfs_mount_t mount=(mockfs_mount_t)dir->mnt->mnt_data;
+ if (dir!=mount->polaris_tmp_root || !node->polaris_dynamic) return EROFS;
+ int found=0;
+ lck_mtx_lock(&mount->mockfs_mnt_mtx);
+ for (unsigned i=0;i<POLARIS_TREE_MAX;i++) if (dir->polaris_children[i]==node) {
+  dir->polaris_children[i]=NULL;node->polaris_linked=0;polaris_tmp_unlinks++;found=1;break;
+ }
+ lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ if (!found) return ENOENT;
+ cache_purge(ap->a_vp);vnode_recycle(ap->a_vp);
+ return 0;
+}
+static int polaris_tmp_inactive(struct vnop_inactive_args *ap)
+{
+ mockfs_fsnode_t node=vnode_fsnode(ap->a_vp);
+ if (node && node->polaris_dynamic) {
+  mockfs_mount_t mount=(mockfs_mount_t)node->mnt->mnt_data;
+  lck_mtx_lock(&mount->mockfs_mnt_mtx);int recycle=!node->polaris_linked;lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+  if (recycle) vnode_recycle(ap->a_vp);
+ }
+ return 0;
+}
+static int polaris_tmp_io(vnode_t vp, struct uio *uio, int writing, int append)
+{
+ mockfs_fsnode_t node=vnode_fsnode(vp);
+ off_t offset=uio_offset(uio);user_ssize_t requested=uio_resid(uio);
+ if (offset<0 || requested<0) return EINVAL;
+ if (!requested) return 0;
+ if (writing && (uint64_t)requested>sizeof(node->polaris_bytes)) return ENOSPC;
+ size_t count=(uint64_t)requested<sizeof(node->polaris_bytes)?(size_t)requested:sizeof(node->polaris_bytes);
+ void *temporary=kalloc_data(count,Z_WAITOK);
+ if (!temporary) return ENOMEM;
+ int error=0;
+ if (writing) {
+  /* Stage the input without advancing the caller's uio on fault or full file. */
+  uio_t copy=uio_duplicate(uio);
+  if (!copy) {kfree_data(temporary,count);return ENOMEM;}
+  error=uiomove((caddr_t)temporary,(int)count,copy);uio_free(copy);
+  if (!error) {
+   lck_mtx_lock(&node->polaris_data_mtx);
+   if (append) offset=(off_t)node->size;
+   if ((uint64_t)offset>sizeof(node->polaris_bytes) || count>sizeof(node->polaris_bytes)-(uint64_t)offset) error=ENOSPC;
+   else {
+    if ((uint64_t)offset>node->size) bzero(node->polaris_bytes+node->size,(size_t)offset-node->size);
+    memcpy(node->polaris_bytes+offset,temporary,count);
+    if ((uint64_t)offset+count>node->size) {node->size=(uint64_t)offset+count;ubc_setsize(vp,(off_t)node->size);}
+    uio_setoffset(uio,offset);uio_update(uio,count);polaris_tmp_writes++;
+   }
+   lck_mtx_unlock(&node->polaris_data_mtx);
+  }
+ } else {
+  lck_mtx_lock(&node->polaris_data_mtx);
+  if ((uint64_t)offset>=node->size) count=0;
+  else if (count>node->size-(uint64_t)offset) count=(size_t)(node->size-(uint64_t)offset);
+  if (count) {memcpy(temporary,node->polaris_bytes+offset,count);polaris_tmp_reads++;}
+  lck_mtx_unlock(&node->polaris_data_mtx);
+  if (count) error=uiomove((caddr_t)temporary,(int)count,uio);
+ }
+ /* Allocation size differs from clipped reads. */
+ size_t allocated=(uint64_t)requested<sizeof(node->polaris_bytes)?(size_t)requested:sizeof(node->polaris_bytes);
+ kfree_data(temporary,allocated);return error;
+}
+static int polaris_tmp_getattr(struct vnop_getattr_args *ap)
+{
+ mockfs_fsnode_t node=vnode_fsnode(ap->a_vp);
+ mockfs_mount_t mount=(mockfs_mount_t)node->mnt->mnt_data;
+ struct vnode_attr *vap=ap->a_vap;
+ uint64_t size=0;int links=1;
+ if (node->polaris_dynamic) {
+  lck_mtx_lock(&node->polaris_data_mtx);size=node->size;lck_mtx_unlock(&node->polaris_data_mtx);
+  lck_mtx_lock(&mount->mockfs_mnt_mtx);links=node->polaris_linked;lck_mtx_unlock(&mount->mockfs_mnt_mtx);
+ }
+ VATTR_RETURN(vap,va_type,node->polaris_dynamic?VREG:VDIR);
+ VATTR_RETURN(vap,va_nlink,links);VATTR_RETURN(vap,va_mode,node->polaris_dynamic?0600:0700);
+ VATTR_RETURN(vap,va_uid,0);VATTR_RETURN(vap,va_gid,0);
+ VATTR_RETURN(vap,va_fileid,node->polaris_id);
+ VATTR_RETURN(vap,va_total_size,size);VATTR_RETURN(vap,va_total_alloc,node->polaris_dynamic?4096:0);
+ VATTR_RETURN(vap,va_data_size,size);VATTR_RETURN(vap,va_data_alloc,node->polaris_dynamic?4096:0);
+ return 0;
+}
+static int polaris_tmp_setattr(struct vnop_setattr_args *ap)
+{
+ mockfs_fsnode_t node=vnode_fsnode(ap->a_vp);struct vnode_attr *vap=ap->a_vap;
+ if (!node->polaris_dynamic) return EROFS;
+ if (VATTR_IS_ACTIVE(vap,va_data_size)) {
+  uint64_t size=vap->va_data_size;
+  if (size>sizeof(node->polaris_bytes)) return EFBIG;
+  lck_mtx_lock(&node->polaris_data_mtx);
+  if (size<node->size) bzero(node->polaris_bytes+size,node->size-size);
+  else if (size>node->size) bzero(node->polaris_bytes+node->size,size-node->size);
