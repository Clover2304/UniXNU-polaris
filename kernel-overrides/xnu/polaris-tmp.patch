+  memcpy(entry.d_name,entries[cookie].name,entry.d_namlen+1);
+  legacy.d_ino=(ino_t)entry.d_ino;legacy.d_type=entry.d_type;legacy.d_namlen=(uint8_t)entry.d_namlen;
+  legacy.d_reclen=(uint16_t)((offsetof(struct dirent,d_name)+entry.d_namlen+1+3)&~3UL);
+  memcpy(legacy.d_name,entry.d_name,entry.d_namlen+1);
+  int extended=ap->a_flags&VNODE_READDIR_EXTENDED;
+  unsigned length=extended?entry.d_reclen:legacy.d_reclen;
+  if (uio_resid(ap->a_uio)<length) {if (!copied) error=EINVAL;break;}
+  error=uiomove(extended?(caddr_t)&entry:(caddr_t)&legacy,length,ap->a_uio);
+  if (error) break;
+  copied++;
+ }
+ uio_setoffset(ap->a_uio,cookie);
+ if (ap->a_numdirent) *ap->a_numdirent=copied;
+ if (ap->a_eofflag) *ap->a_eofflag=(cookie==POLARIS_TREE_MAX+2);
+ return error;
+}
