+  mockfs_fsnode_t node=NULL;
+  int error=mockfs_fsnode_create(mp,(e->flags&POLARIS_TREE_DIR)?MOCKFS_DEV:MOCKFS_FILE,&node);
+  if(error)return error;
+  node->polaris_named=1;node->polaris_exec=(e->flags&POLARIS_TREE_EXEC)!=0;
+  node->polaris_id=i+2;node->backing_offset=e->offset;node->size=e->size;
+  memcpy(node->polaris_name,e->name,sizeof(node->polaris_name));
+  error=mockfs_fsnode_adopt(nodes[e->parent],node);
+  if(error){mockfs_fsnode_destroy(node);return error;}
+  nodes[i+1]=node;
+  if(e->flags&POLARIS_TREE_RAM) {
