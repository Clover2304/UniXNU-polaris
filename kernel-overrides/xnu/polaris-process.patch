+/* Boot-owner identities only; no platform or entitlement privileges. */
+#ifndef POLARIS_PROCESS_POLICY_H
+#define POLARIS_PROCESS_POLICY_H
+static inline errno_t
+polaris_process_blob_policy(const struct cs_blob *blob, int pid, int ppid,
+    int enabled, const char *expected)
+{
+ const unsigned required=CS_ADHOC|CS_HARD|CS_KILL;
+ if(pid!=1 && !(pid>1 && ppid==1 && enabled==1))return EPERM;
+ if(!blob || (blob->csb_flags&required)!=required || blob->csb_platform_binary || blob->csb_platform_path ||
+    blob->csb_entitlements || blob->csb_entitlements_blob || blob->csb_der_entitlements_blob ||
+    !expected || strnlen(expected,CS_CDHASH_LEN*2+2)!=CS_CDHASH_LEN*2)return EPERM;
+ for(unsigned i=0;i<CS_CDHASH_LEN;i++) {
+  unsigned value=0;
+  for(unsigned half=0;half<2;half++) {
+   unsigned char c=expected[i*2+half];
+   if(c>='0'&&c<='9')value=(value<<4)|(c-'0');
+   else if(c>='a'&&c<='f')value=(value<<4)|(c-'a'+10);
+   else return EPERM;
+  }
+  if(blob->csb_cdhash[i]!=value)return EPERM;
+ }
+ return 0;
+}
+#endif
