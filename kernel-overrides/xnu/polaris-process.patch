+/* Bounded N4KROOT v3 directory table. Native little endian; all extents 4K.
+ * No runtime namespace mutation. The same validator is exercised on the host.
+ */
+#ifndef MOCKFS_POLARIS_TREE_H
+#define MOCKFS_POLARIS_TREE_H
+#define POLARIS_TREE_MAX 16
+#define POLARIS_TREE_DIR 1
+#define POLARIS_TREE_EXEC 2
+#define POLARIS_TREE_RAM 4
+struct polaris_tree_entry {
+ uint32_t parent, flags;
+ uint64_t offset, size;
+ char name[32];
+ uint64_t reserved;
+};
+struct polaris_tree_header {
+ char magic[8];
+ uint32_t version, count;
+ uint64_t image_bytes, reserved[3];
+ uint8_t padding[16];
+ struct polaris_tree_entry entries[POLARIS_TREE_MAX];
+};
+_Static_assert(sizeof(struct polaris_tree_entry)==64, "tree entry ABI");
+_Static_assert(__builtin_offsetof(struct polaris_tree_header,entries)==64, "tree table ABI");
+static inline int
+polaris_tree_validate(const struct polaris_tree_header *h, uint64_t bytes)
+{
+ const char magic[8]={'N','4','K','R','O','O','T',0};
+ for (unsigned j=0;j<8;j++) if(h->magic[j]!=magic[j])return -1;
+ if(h->version!=3 || !h->count || h->count>POLARIS_TREE_MAX ||
+    bytes<4096 || bytes>32*1024*1024 || (bytes&4095) || h->image_bytes!=bytes)return -1;
+ for(unsigned j=0;j<3;j++)if(h->reserved[j])return -1;
+ for(unsigned j=0;j<16;j++)if(h->padding[j])return -1;
+ uint64_t end=4096;
+ for(unsigned i=0;i<h->count;i++) {
+  const struct polaris_tree_entry *e=&h->entries[i];
+  if(e->parent>i || e->reserved || (e->flags&~7U))return -1;
+  if(e->parent && h->entries[e->parent-1].flags!=POLARIS_TREE_DIR)return -1;
+  unsigned n=0;
+  while(n<32 && e->name[n]) {
+   unsigned char c=e->name[n++];
+   if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='.'||c=='_'||c=='-'))return -1;
+  }
+  if(!n || n==32 || (n==1&&e->name[0]=='.') || (n==2&&e->name[0]=='.'&&e->name[1]=='.'))return -1;
+  for(unsigned j=n;j<32;j++)if(e->name[j])return -1;
+  for(unsigned j=0;j<i;j++)if(e->parent==h->entries[j].parent) {
+   unsigned k=0;while(k<32&&e->name[k]==h->entries[j].name[k])k++;
+   if(k==32)return -1;
+  }
+  if(e->flags&POLARIS_TREE_DIR) {
+   if(e->flags!=POLARIS_TREE_DIR || e->offset || e->size)return -1;
+  } else {
+   if((e->flags&(POLARIS_TREE_EXEC|POLARIS_TREE_RAM))==(POLARIS_TREE_EXEC|POLARIS_TREE_RAM) ||
+      !e->size || (e->offset&4095) || e->offset<end || e->offset>bytes || e->size>bytes-e->offset)return -1;
+   uint64_t padded=(e->size+4095)&~4095ULL;
+   if(padded>bytes-e->offset || ((e->flags&POLARIS_TREE_RAM)&&e->size!=4096))return -1;
+   end=e->offset+padded;
+  }
+ }
+ return 0;
+}
+#endif
